{
  "name": "lean-dafny-trial",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "dafny-lang.ide-vscode"
      ],
      "settings": {
        "dafny.dafnyPath": "/home/codespace/.local/opt/dafny/dafny"
      }
    }
  }
}
